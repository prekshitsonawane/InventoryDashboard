@model InventoryDashboard.Models.LoginViewModel
@{
    Layout = null; // Login page has its own standalone layout
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Login to the Internal Inventory Management System." />
    <title>Login — Inventory Management System</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Merriweather:wght@400;700&family=Source+Sans+3:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="login-body">

    <div class="login-bg-pattern"></div>

    <div class="login-wrapper">
        <!-- Left Panel -->
        <div class="login-left d-none d-lg-flex position-relative overflow-hidden">
            <!-- Professional Solid Gradient Background -->
            <div class="position-absolute inset-0 w-100 h-100" style="background: linear-gradient(135deg, #9B27E6 0%, #7C1FB8 100%); z-index: 1;"></div>

            <!-- Premium 3D Interactive Model (Spline) (Foreground Layer) -->
            <script type="module" src="https://unpkg.com/@@splinetool/viewer@1.0.94/build/spline-viewer.js"></script>
            <div class="position-absolute w-100 h-100" style="top: 0; left: 0; z-index: 3;">
                <!-- Interactive 3D Robot (Whobee) -->
                <spline-viewer url="https://prod.spline.design/PyzDhpQ9E5f1E3MT/scene.splinecode" loading-anim-type="spinner"></spline-viewer>
            </div>

            <!-- Overlay Content (Moved to top-left corner) -->
            <div class="login-left-content position-absolute w-100 h-100 d-flex flex-column justify-content-start align-items-start p-4 p-md-5" style="top: 0; left: 0; z-index: 2; pointer-events: none;">
                <div class="glass-panel" style="max-width: 600px;">
                    <div class="d-flex align-items-center gap-3 mb-2">
                        <div class="login-brand-icon m-0" style="width: 50px; height: 50px;">
                            <i class="bi bi-boxes" style="font-size: 1.8rem; color: #fff; text-shadow: 0 4px 15px rgba(0,0,0,0.5);"></i>
                        </div>
                        <h1 class="login-headline m-0" style="color: #fff; text-shadow: 0 4px 15px rgba(0,0,0,0.5); font-size: 2.2rem;">InvenTrack</h1>
                    </div>
                    <p class="login-tagline text-white mb-0 ms-1" style="text-shadow: 0 2px 10px rgba(0,0,0,0.8); font-size: 1rem; font-weight: 500; opacity: 0.9;">Internal Asset Management System</p>
                </div>
            </div>
        </div>

        <!-- Right Panel: Form -->
        <div class="login-right">
            <div class="login-card">
                <div class="login-card-header">
                    <div class="login-logo d-lg-none mb-3">
                        <i class="bi bi-boxes"></i>
                    </div>
                    <h2 class="login-title">Welcome Back</h2>
                    <p class="login-subtitle">Sign in to your account to continue</p>
                </div>

                <form asp-controller="Account" asp-action="Login" method="post" id="loginForm" novalidate>
                    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="All" class="alert alert-danger alert-sm py-2 mb-3" style="display:none" id="errorSummary"></div>

                    @{
                        var errors = ViewData.ModelState.Values.SelectMany(v => v.Errors).ToList();
                        if (errors.Any())
                        {
                            <div class="alert alert-danger alert-sm py-2 mb-3">
                                <i class="bi bi-exclamation-triangle me-2"></i>
                                @errors.First().ErrorMessage
                            </div>
                        }
                    }

                    <div class="form-floating mb-3">
                        <input asp-for="UserName" class="form-control" id="username" placeholder="Username"
                               autocomplete="username" autofocus />
                        <label for="username"><i class="bi bi-person me-1"></i> Username</label>
                        <span asp-validation-for="UserName" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-3 position-relative">
                        <input asp-for="Password" class="form-control" id="password"
                               placeholder="Password" autocomplete="current-password" />
                        <label for="password"><i class="bi bi-lock me-1"></i> Password</label>
                        <button type="button" class="btn-toggle-pw" onclick="togglePassword()" title="Show/hide password">
                            <i class="bi bi-eye" id="pwToggleIcon"></i>
                        </button>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="d-flex align-items-center justify-content-between mb-4">
                        <div class="form-check">
                            <input asp-for="RememberMe" class="form-check-input" id="rememberMe" />
                            <label class="form-check-label text-muted small" for="rememberMe">
                                Remember me for 8 hours
                            </label>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 btn-login" id="loginBtn">
                        <span class="btn-text"><i class="bi bi-box-arrow-in-right me-2"></i>Sign In</span>
                        <span class="spinner-border spinner-border-sm d-none" id="loginSpinner"></span>
                    </button>
                </form>

                <div class="login-card-footer mt-4 text-center text-muted small">
                    <i class="bi bi-lock-fill me-1"></i>
                    Authorized personnel only. All access is logged.
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        document.getElementById('loginForm').addEventListener('submit', function () {
            document.getElementById('loginBtn').disabled = true;
            document.getElementById('loginSpinner').classList.remove('d-none');
            document.querySelector('.btn-text').innerHTML = 'Signing in...';
        });
        function togglePassword() {
            var pw = document.getElementById('password');
            var icon = document.getElementById('pwToggleIcon');
            if (pw.type === 'password') {
                pw.type = 'text';
                icon.className = 'bi bi-eye-slash';
            } else {
                pw.type = 'password';
                icon.className = 'bi bi-eye';
            }
        }
    </script>
</body>
</html>
