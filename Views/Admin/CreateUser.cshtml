@model InventoryDashboard.Models.CreateUserViewModel
@{
    ViewData["Title"] = "Create User";
    var roles = (List<string>)ViewBag.Roles;
}

<div class="page-header">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Users">User Management</a></li>
                <li class="breadcrumb-item active">Create User</li>
            </ol>
        </nav>
        <h1 class="page-title"><i class="bi bi-person-plus me-2"></i>Create New User</h1>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card">
            <div class="card-body p-4">
                <div asp-validation-summary="All" class="alert alert-danger py-2 mb-3"></div>
                <form asp-action="CreateUser" method="post" novalidate id="createUserForm">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="UserName" class="form-label fw-semibold"></label>
                        <input asp-for="UserName" class="form-control" placeholder="e.g. john.doe" />
                        <span asp-validation-for="UserName" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-semibold"></label>
                        <input asp-for="FullName" class="form-control" placeholder="Full display name" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Department" class="form-label fw-semibold"></label>
                        <input asp-for="Department" class="form-control" placeholder="e.g. Finance, IT, HR" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Role" class="form-label fw-semibold"></label>
                        <select asp-for="Role" class="form-select" id="roleSelect">
                            @foreach (var r in roles)
                            {
                                <option value="@r">@r</option>
                            }
                        </select>
                        <div class="mt-2">
                            <span class="badge bg-danger me-1">Admin</span> Full access + delete + audit<br/>
                            <span class="badge bg-primary me-1">Editor</span> Add & update, no delete<br/>
                            <span class="badge bg-secondary me-1">Viewer</span> Read-only access
                        </div>
                    </div>
                    <hr class="my-3" />
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold"></label>
                        <input asp-for="Password" type="password" class="form-control"
                               placeholder="Min 8 chars, 1 upper, 1 digit, 1 special" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                        <div class="form-text text-muted">User will be prompted to change this on first login.</div>
                    </div>
                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2 justify-content-end">
                        <a asp-action="Users" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary" id="btnCreateUserSubmit">
                            <i class="bi bi-person-plus me-1"></i> Create User
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
