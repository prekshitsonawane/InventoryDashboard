@model InventoryDashboard.Models.ResetPasswordViewModel
@{
    ViewData["Title"] = $"Reset Password — {Model.UserName}";
}

<div class="page-header">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Users">User Management</a></li>
                <li class="breadcrumb-item active">Reset Password</li>
            </ol>
        </nav>
        <h1 class="page-title"><i class="bi bi-key me-2"></i>Reset Password</h1>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body p-4">
                <div class="alert alert-info mb-4">
                    <i class="bi bi-info-circle me-2"></i>
                    Resetting password for user: <strong>@Model.UserName</strong>.
                    They will be required to change it on next login.
                </div>

                <div asp-validation-summary="All" class="alert alert-danger py-2 mb-3"></div>

                <form asp-action="ResetPassword" method="post" novalidate id="resetPasswordForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="UserId" />
                    <input type="hidden" asp-for="UserName" />

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label fw-semibold"></label>
                        <input asp-for="NewPassword" type="password" class="form-control"
                               placeholder="Min 8 chars, 1 upper, 1 digit, 1 special" />
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2 justify-content-end">
                        <a asp-action="Users" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-warning" id="btnResetPwSubmit">
                            <i class="bi bi-key me-1"></i> Reset Password
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
