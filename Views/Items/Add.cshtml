@model InventoryDashboard.Models.AddUpdateItemViewModel
@{
    ViewData["Title"] = "Add New Item";
    var cats = (List<string>)ViewBag.Categories;
    var stats = (List<string>)ViewBag.Statuses;
    var conds = (List<string>)ViewBag.Conditions;
}

<div class="page-header">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Dashboard</a></li>
                <li class="breadcrumb-item"><a asp-controller="Items" asp-action="Index">Inventory</a></li>
                <li class="breadcrumb-item active">Add New Item</li>
            </ol>
        </nav>
        <h1 class="page-title"><i class="bi bi-plus-circle me-2"></i>Add New Item</h1>
    </div>
</div>

<form asp-action="Add" method="post" novalidate id="addItemForm">
    @Html.AntiForgeryToken()
    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="alert alert-danger py-2 mb-3"></div>
    }

    <div class="row g-4">
        <!-- Basic Info -->
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header"><i class="bi bi-info-circle me-2 text-primary"></i>Basic Information</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold"></label>
                        <input asp-for="Name" class="form-control" placeholder="Enter item name" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="SerialNumber" class="form-label fw-semibold"></label>
                        <input asp-for="SerialNumber" class="form-control font-mono" placeholder="Unique Serial/Asset ID" />
                        <span asp-validation-for="SerialNumber" class="text-danger small"></span>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Category" class="form-label fw-semibold"></label>
                            <select asp-for="Category" class="form-select">
                                <option value="">— Select —</option>
                                @foreach (var c in cats) { <option value="@c">@c</option> }
                            </select>
                            <span asp-validation-for="Category" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Brand" class="form-label fw-semibold"></label>
                            <input asp-for="Brand" class="form-control" placeholder="Brand/Manufacturer" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Model" class="form-label fw-semibold"></label>
                        <input asp-for="Model" class="form-control" placeholder="Model name or number" />
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Status" class="form-label fw-semibold"></label>
                            <select asp-for="Status" class="form-select">
                                @foreach (var s in stats) { <option value="@s">@s</option> }
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Condition" class="form-label fw-semibold"></label>
                            <select asp-for="Condition" class="form-select">
                                @foreach (var c in conds) { <option value="@c">@c</option> }
                            </select>
                            <span asp-validation-for="Condition" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Assignment + Purchase -->
        <div class="col-lg-6">
            <div class="card mb-4">
                <div class="card-header"><i class="bi bi-person-check me-2 text-primary"></i>Assignment</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Department" class="form-label fw-semibold"></label>
                        <input asp-for="Department" class="form-control" placeholder="Department name" />
                        <span asp-validation-for="Department" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="AssignedTo" class="form-label fw-semibold"></label>
                        <input asp-for="AssignedTo" class="form-control" placeholder="Employee name" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Location" class="form-label fw-semibold"></label>
                        <input asp-for="Location" class="form-control" placeholder="Building/Floor/Room" />
                    </div>
                </div>
            </div>
            <div class="card">
                <div class="card-header"><i class="bi bi-receipt me-2 text-primary"></i>Purchase & Lifecycle</div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6 mb-3">
                            <label asp-for="PurchaseDate" class="form-label fw-semibold"></label>
                            <input asp-for="PurchaseDate" type="date" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="PurchasePrice" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text">₹</span>
                                <input asp-for="PurchasePrice" type="text" class="form-control" placeholder="0.00 or text" />
                            </div>
                            <span asp-validation-for="PurchasePrice" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="InstalledDate" class="form-label fw-semibold"></label>
                            <input asp-for="InstalledDate" type="date" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="WarrantyExpiryDate" class="form-label fw-semibold"></label>
                            <input asp-for="WarrantyExpiryDate" type="date" class="form-control" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Vendor" class="form-label fw-semibold"></label>
                        <input asp-for="Vendor" class="form-control" placeholder="Supplier name" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="InvoiceNumber" class="form-label fw-semibold"></label>
                        <input asp-for="InvoiceNumber" class="form-control" placeholder="Bill/Invoice ID" />
                    </div>
                </div>
            </div>
        </div>

        <!-- Notes -->
        <div class="col-12">
            <div class="card">
                <div class="card-header"><i class="bi bi-chat-left-text me-2 text-primary"></i>Notes</div>
                <div class="card-body">
                    <textarea asp-for="Notes" class="form-control" rows="3"
                              placeholder="Additional remarks, maintenance history, etc."></textarea>
                    <span asp-validation-for="Notes" class="text-danger small"></span>
                </div>
            </div>
        </div>
    </div>

    <!-- Form Actions -->
    <div class="form-actions mt-4">
        <a asp-action="Index" class="btn btn-outline-secondary" id="btnCancelAdd">
            <i class="bi bi-x me-1"></i> Cancel
        </a>
        <button type="submit" class="btn btn-success" id="btnSubmitAdd">
            <i class="bi bi-save me-1"></i> Save Item
        </a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
