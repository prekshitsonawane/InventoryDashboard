@model InventoryDashboard.Models.AddUpdateItemViewModel
@{
    ViewData["Title"] = $"Update Item — {Model.Name}";
    var cats = (List<string>)ViewBag.Categories;
    var stats = (List<string>)ViewBag.Statuses;
    var conds = (List<string>)ViewBag.Conditions;
}

<div class="page-header">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Dashboard</a></li>
                <li class="breadcrumb-item"><a asp-controller="Items" asp-action="Index">Inventory</a></li>
                <li class="breadcrumb-item">
                    <a asp-controller="Items" asp-action="Details" asp-route-id="@Model.ItemID">@Model.Name</a>
                </li>
                <li class="breadcrumb-item active">Edit</li>
            </ol>
        </nav>
        <h1 class="page-title"><i class="bi bi-pencil-square me-2"></i>Update Item</h1>
    </div>
</div>

<!-- Warning Banner -->
<div class="alert alert-warning d-flex align-items-center mb-4">
    <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
    <div>You are editing an existing asset record. <strong>Changes will be saved immediately</strong> upon submission.</div>
</div>

<form asp-action="Update" asp-route-id="@Model.ItemID" method="post" novalidate id="updateItemForm">
    @Html.AntiForgeryToken()
    <input asp-for="ItemID" type="hidden" />
    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="alert alert-danger py-2 mb-3"></div>
    }

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header"><i class="bi bi-info-circle me-2 text-primary"></i>Basic Information</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="SerialNumber" class="form-label fw-semibold"></label>
                        <input asp-for="SerialNumber" class="form-control font-mono" />
                        <span asp-validation-for="SerialNumber" class="text-danger small"></span>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Category" class="form-label fw-semibold"></label>
                            <select asp-for="Category" class="form-select">
                                <option value="">— Select —</option>
                                @foreach (var c in cats) { <option value="@c" selected="@(Model.Category == c)">@c</option> }
                            </select>
                            <span asp-validation-for="Category" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Brand" class="form-label fw-semibold"></label>
                            <input asp-for="Brand" class="form-control" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Model" class="form-label fw-semibold"></label>
                        <input asp-for="Model" class="form-control" />
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Status" class="form-label fw-semibold"></label>
                            <select asp-for="Status" class="form-select">
                                @foreach (var s in stats) { <option value="@s" selected="@(Model.Status == s)">@s</option> }
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Condition" class="form-label fw-semibold"></label>
                            <select asp-for="Condition" class="form-select">
                                @foreach (var c in conds) { <option value="@c" selected="@(Model.Condition == c)">@c</option> }
                            </select>
                            <span asp-validation-for="Condition" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card mb-4">
                <div class="card-header"><i class="bi bi-person-check me-2 text-primary"></i>Assignment</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Department" class="form-label fw-semibold"></label>
                        <input asp-for="Department" class="form-control" />
                        <span asp-validation-for="Department" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="AssignedTo" class="form-label fw-semibold"></label>
                        <input asp-for="AssignedTo" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Location" class="form-label fw-semibold"></label>
                        <input asp-for="Location" class="form-control" />
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header"><i class="bi bi-receipt me-2 text-primary"></i>Purchase & Lifecycle</div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6 mb-3">
                            <label asp-for="PurchaseDate" class="form-label fw-semibold"></label>
                            <input asp-for="PurchaseDate" type="date" class="form-control"
                                   value="@Model.PurchaseDate?.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="PurchasePrice" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text">₹</span>
                                <input asp-for="PurchasePrice" type="text" class="form-control" />
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="InstalledDate" class="form-label fw-semibold"></label>
                            <input asp-for="InstalledDate" type="date" class="form-control"
                                   value="@Model.InstalledDate?.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="WarrantyExpiryDate" class="form-label fw-semibold"></label>
                            <input asp-for="WarrantyExpiryDate" type="date" class="form-control"
                                   value="@Model.WarrantyExpiryDate?.ToString("yyyy-MM-dd")" />
                        </div>
                    </div>                    <div class="mb-3">
                        <label asp-for="Vendor" class="form-label fw-semibold"></label>
                        <input asp-for="Vendor" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="InvoiceNumber" class="form-label fw-semibold"></label>
                        <input asp-for="InvoiceNumber" class="form-control" />
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card">
                <div class="card-header"><i class="bi bi-chat-left-text me-2 text-primary"></i>Notes</div>
                <div class="card-body">
                    <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                </div>
            </div>
        </div>
    </div>

    <div class="form-actions mt-4">
        @if (User.IsInRole("Admin"))
        {
            <button type="button" class="btn btn-outline-danger me-auto"
                    data-bs-toggle="modal" data-bs-target="#deleteModal" id="btnDeleteFromUpdate">
                <i class="bi bi-trash me-1"></i> Delete Item
            </button>
        }
        <a asp-action="Details" asp-route-id="@Model.ItemID" class="btn btn-outline-secondary">
            <i class="bi bi-x me-1"></i> Cancel
        </a>
        <button type="submit" class="btn btn-primary" id="btnSubmitUpdate">
            <i class="bi bi-save me-1"></i> Save Changes
        </button>
    </div>
</form>

@if (User.IsInRole("Admin"))
{
    <div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title"><i class="bi bi-exclamation-triangle me-2"></i>Confirm Delete</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to permanently delete <strong>@Model.Name</strong>?</p>
                    <p class="text-danger small"><i class="bi bi-exclamation-circle me-1"></i>This action cannot be undone.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <form asp-action="Delete" asp-route-id="@Model.ItemID" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger" id="btnConfirmDeleteUpdate">
                            <i class="bi bi-trash me-1"></i> Yes, Delete Permanently
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
