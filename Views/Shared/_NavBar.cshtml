<nav class="navbar navbar-expand-lg app-navbar fixed-top" id="mainNavbar">
    <div class="container-fluid px-4">

        <!-- Brand -->
        <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
            <div class="brand-icon">
                <i class="bi bi-boxes"></i>
            </div>
            <div class="brand-text">
                <span class="brand-title">InvenTrack</span>
                <span class="brand-sub">Asset Management</span>
            </div>
        </a>

        <!-- Mobile Toggle -->
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain"
                aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Nav Links -->
        <div class="collapse navbar-collapse" id="navbarMain">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-3">
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
                       asp-controller="Home" asp-action="Index">
                        <i class="bi bi-speedometer2 me-1"></i> Dashboard
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Items" ? "active" : "")"
                       asp-controller="Items" asp-action="Index">
                        <i class="bi bi-table me-1"></i> Inventory
                    </a>
                </li>
                @if (User.IsInRole("Admin") || User.IsInRole("Editor"))
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Items" asp-action="Add">
                            <i class="bi bi-plus-circle me-1"></i> Add Item
                        </a>
                    </li>
                }
                @if (User.IsInRole("Admin"))
                {
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" ? "active" : "")"
                           href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-shield-lock me-1"></i> Admin
                        </a>
                        <ul class="dropdown-menu shadow-sm">
                            <li>
                                <a class="dropdown-item" asp-controller="Admin" asp-action="Users">
                                    <i class="bi bi-people me-2"></i> User Management
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-controller="Admin" asp-action="AuditLog">
                                    <i class="bi bi-journal-text me-2"></i> Audit Log
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-controller="Admin" asp-action="Import">
                                    <i class="bi bi-upload me-2"></i> Bulk Import
                                </a>
                            </li>
                        </ul>
                    </li>
                }
            </ul>

            <!-- Right Side: User Info + Logout -->
            <div class="d-flex align-items-center gap-3">
                <div class="user-info d-none d-lg-flex align-items-center gap-2">
                    <div class="user-avatar">
                        <i class="bi bi-person-fill"></i>
                    </div>
                    <div class="user-details">
                        <span class="user-name">@User.Identity?.Name</span>
                        <span class="user-role">
                            @if (User.IsInRole("Admin")) { <text>Administrator</text> }
                            else if (User.IsInRole("Editor")) { <text>Editor</text> }
                            else { <text>Viewer</text> }
                        </span>
                    </div>
                </div>

                <form method="post" asp-controller="Account" asp-action="Logout" class="m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger btn-sm logout-btn" id="logoutBtn">
                        <i class="bi bi-box-arrow-right me-1"></i> Logout
                    </button>
                </form>
            </div>
        </div>
    </div>
</nav>
